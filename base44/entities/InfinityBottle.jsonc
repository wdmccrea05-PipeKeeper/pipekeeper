{
  "name": "InfinityBottle",
  "type": "object",
  "description": "Documentation for an infinity bottle: the vessel, when it was started, and every component that has been added to it. Components are appended and never edited, so the record keeps a dated history of what went in and in what quantity.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Label for this infinity bottle"
    },
    "bottle_id": {
      "type": "string",
      "description": "Id of the Bottle record for the physical vessel, when one is tracked in the collection"
    },
    "started_date": {
      "type": "string",
      "format": "date",
      "description": "Date the infinity bottle was started"
    },
    "capacity_ml": {
      "type": "number",
      "description": "Documented capacity of the vessel in millilitres"
    },
    "components": {
      "type": "array",
      "description": "Every whiskey added to this infinity bottle, oldest first. Append-only history.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "component_name": {
            "type": "string"
          },
          "bottle_id": {
            "type": "string"
          },
          "distillery": {
            "type": "string"
          },
          "volume_ml": {
            "type": "number"
          },
          "added_at": {
            "type": "string",
            "format": "date"
          },
          "characteristics": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Free-text notes about this infinity bottle"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photographs of the vessel and its labels"
    },
    "documents": {
      "type": "array",
      "description": "Supporting documents stored privately; each entry keeps the private file reference.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receipt",
              "certificate",
              "photograph",
              "document",
              "appraisal",
              "other"
            ]
          },
          "file_uri": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "size": {
            "type": "number"
          }
        }
      }
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "transferred",
        "gifted",
        "sold",
        "lost",
        "disposed"
      ],
      "enumColors": [
        "green",
        "gray",
        "blue",
        "purple",
        "yellow",
        "red",
        "red"
      ],
      "default": "active",
      "description": "Lifecycle state of the record. Non-active states retain the record and its history."
    },
    "created_by": {
      "type": "string",
      "description": "Email of the collector who created this record"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}