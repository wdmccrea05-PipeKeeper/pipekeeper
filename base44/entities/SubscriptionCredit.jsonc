{
  "name": "SubscriptionCredit",
  "type": "object",
  "description": "Tracks free month/year credits earned via referrals. Applied to extend or skip billing.",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "credit_type": {
      "type": "string",
      "enum": [
        "free_month",
        "free_year"
      ],
      "description": "Type of credit granted"
    },
    "source": {
      "type": "string",
      "enum": [
        "referral",
        "manual",
        "promotion"
      ],
      "default": "referral"
    },
    "source_referral_event_id": {
      "type": "string"
    },
    "months_granted": {
      "type": "number",
      "description": "1 for free_month, 12 for free_year"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "expired",
        "voided"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "credit_type",
    "months_granted",
    "granted_at",
    "status"
  ]
}