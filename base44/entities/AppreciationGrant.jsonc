{
  "name": "AppreciationGrant",
  "type": "object",
  "description": "One server-authorized promotional Pro grant per collector per campaign. Timestamps are generated by the backend only; the record is never writable from the app.",
  "properties": {
    "campaign_id": {
      "type": "string",
      "description": "Campaign identifier, e.g. collector_appreciation_black_friday_2026"
    },
    "user_id": {
      "type": "string",
      "description": "Platform user id of the collector who redeemed the offer"
    },
    "user_email": {
      "type": "string",
      "description": "Normalized lowercase email of the collector"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "enumColors": [
        "green",
        "gray",
        "red"
      ],
      "default": "active",
      "description": "Lifecycle status. Effective status is always recomputed from the timestamps at read time."
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-generated activation timestamp (never the account creation date)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-generated expiration, exactly 168 hours after activated_at"
    },
    "grant_hours": {
      "type": "number",
      "default": 168,
      "description": "Grant duration in hours"
    },
    "source": {
      "type": "string",
      "default": "appreciation_campaign",
      "description": "Grant source, used for reporting and audit"
    },
    "reason": {
      "type": "string",
      "description": "Human-readable reason recorded with the grant"
    },
    "redeemed_by": {
      "type": "string",
      "description": "Email of the collector who triggered the redemption"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the redemption request was accepted"
    },
    "expired_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the grant was observed as expired"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an administrator revoked the grant"
    },
    "revoked_reason": {
      "type": "string",
      "description": "Administrative note for a revocation"
    }
  },
  "required": [
    "campaign_id",
    "user_id",
    "user_email",
    "activated_at",
    "expires_at",
    "source"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}