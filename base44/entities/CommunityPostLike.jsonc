{
  "name": "CommunityPostLike",
  "type": "object",
  "description": "One row per collector per liked community post.",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "ID of the CommunityPost that was liked"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the collector who liked the post"
    }
  },
  "required": [
    "post_id",
    "user_email"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}