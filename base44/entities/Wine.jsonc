{
  "name": "Wine",
  "type": "object",
  "description": "A wine bottle in a user's WineKeeper collection. Supports zero-inventory (quantity=0) as a valid state and non-destructive archiving. Acquisition, provenance, identity and document fields are shared with every other collection module and are all optional.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the wine"
    },
    "producer": {
      "type": "string",
      "description": "Winery, ch\u00e2teau, or producer name"
    },
    "region": {
      "type": "string",
      "description": "Wine region (e.g. Napa Valley, Bordeaux, Tuscany)"
    },
    "appellation": {
      "type": "string",
      "description": "Appellation or sub-region"
    },
    "varietal": {
      "type": "string",
      "description": "Primary grape variety"
    },
    "blend_components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Grape varieties in the blend"
    },
    "vintage": {
      "type": "number",
      "description": "Vintage year (e.g. 2018)"
    },
    "style": {
      "type": "string",
      "enum": [
        "red",
        "white",
        "ros\u00e9",
        "sparkling",
        "dessert",
        "fortified",
        "orange",
        "other"
      ],
      "description": "Style or color category of the wine"
    },
    "bottle_size": {
      "type": "string",
      "description": "Bottle format (e.g. 750ml, Magnum)"
    },
    "abv": {
      "type": "number",
      "description": "Alcohol by volume percentage"
    },
    "country_of_origin": {
      "type": "string",
      "description": "Country of origin"
    },
    "drink_window_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the recommended drinking window"
    },
    "drink_window_end": {
      "type": "string",
      "format": "date",
      "description": "End of the recommended drinking window"
    },
    "storage_location_id": {
      "type": "string",
      "description": "Foreign key to a StorageLocation record"
    },
    "purchase_price": {
      "type": "number",
      "description": "Price paid at purchase"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date the bottle was acquired (historical record)"
    },
    "purchase_source": {
      "type": "string",
      "description": "User-entered historical acquisition source. A record of where the bottle came from, never a live link."
    },
    "estimated_value": {
      "type": "number",
      "description": "Current estimated market value"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "Number of bottles in inventory. Zero is a legitimate state (empty/finished). Do NOT default to 1."
    },
    "notes": {
      "type": "string",
      "description": "Free-text personal notes about this wine"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of photo URLs"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this wine is marked as a favorite"
    },
    "ai_excluded": {
      "type": "boolean",
      "default": false,
      "description": "Whether this wine is excluded from AI recommendations"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this wine has been archived (removed from normal collection browsing but history retained). Non-destructive \u2014 reversible via unarchive."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this wine was archived. Null when not archived."
    },
    "original_owner": {
      "type": "string",
      "description": "Documented original owner, if the bottle was not acquired new"
    },
    "provenance_notes": {
      "type": "string",
      "description": "Free-text provenance documentation: prior owners, cellar history, authentication notes"
    },
    "serial_number": {
      "type": "string",
      "description": "Serial, bottle or lot number where applicable"
    },
    "batch_number": {
      "type": "string",
      "description": "Batch, lot or disgorgement identifier where applicable"
    },
    "production_date": {
      "type": "string",
      "format": "date",
      "description": "Recorded production or bottling date, when known"
    },
    "condition": {
      "type": "string",
      "description": "Documented condition of the bottle (fill level, label, capsule, seal)"
    },
    "condition_notes": {
      "type": "string",
      "description": "Free-text condition documentation"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags and classifications for filtering"
    },
    "documents": {
      "type": "array",
      "description": "Supporting documents (receipts, certificates, photographs). Files are stored privately; each entry keeps the private file reference, not a public URL.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receipt",
              "certificate",
              "photograph",
              "document",
              "appraisal",
              "other"
            ]
          },
          "file_uri": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "size": {
            "type": "number"
          }
        }
      }
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "transferred",
        "gifted",
        "sold",
        "lost",
        "disposed"
      ],
      "enumColors": [
        "green",
        "gray",
        "blue",
        "purple",
        "yellow",
        "red",
        "red"
      ],
      "default": "active",
      "description": "Lifecycle state of the record. Non-active states retain the record and its history."
    },
    "lifecycle_note": {
      "type": "string",
      "description": "Why the record is inactive, and to whom it went when transferred or gifted"
    },
    "merged_into_id": {
      "type": "string",
      "description": "When this record was merged into another, the surviving record's id"
    },
    "merged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was merged"
    },
    "created_by": {
      "type": "string",
      "description": "Email of the user who created this record"
    }
  },
  "required": [
    "name",
    "producer",
    "created_by"
  ]
}