{
  "name": "TobaccoBlend",
  "type": "object",
  "description": "A tobacco blend in a user's cellar. Packaging, cellaring, production and documentation fields are shared with the other collection modules and are all optional.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the tobacco blend"
    },
    "manufacturer": {
      "type": "string",
      "description": "Company that makes the blend"
    },
    "blend_type": {
      "type": "string",
      "enum": [
        "American",
        "Aromatic",
        "Balkan",
        "Burley",
        "Burley-based",
        "Cavendish",
        "Codger Blend",
        "Dark Fired Kentucky",
        "English",
        "English Aromatic",
        "English Balkan",
        "Full English/Oriental",
        "Kentucky",
        "Lakeland",
        "Latakia Blend",
        "Navy Flake",
        "Oriental/Turkish",
        "Other",
        "Perique",
        "Shag",
        "Virginia",
        "Virginia/Burley",
        "Virginia/Oriental",
        "Virginia/Perique"
      ],
      "description": "Primary blend category"
    },
    "tobacco_components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of tobacco types in the blend"
    },
    "is_aromatic": {
      "type": "boolean",
      "description": "Whether this blend uses aromatic casings/toppings. Separate from tobacco composition."
    },
    "aromatic_intensity": {
      "type": "string",
      "enum": [
        "light",
        "medium",
        "heavy"
      ],
      "description": "Intensity of aromatic treatment when is_aromatic is true."
    },
    "blend_family": {
      "type": "string",
      "description": "Normalized blend family separate from tobacco composition."
    },
    "casing": {
      "type": "string",
      "description": "Casing flavors applied to the tobacco."
    },
    "topping": {
      "type": "string",
      "description": "Topping flavors applied post-processing."
    },
    "cut": {
      "type": "string",
      "enum": [
        "Broken Flake",
        "Coin",
        "Crumble Cake",
        "Cube Cut",
        "Flake",
        "Other",
        "Plug",
        "Ready Rubbed",
        "Ribbon",
        "Rope",
        "Shag",
        "Twist"
      ],
      "description": "How the tobacco is cut"
    },
    "strength": {
      "type": "string",
      "enum": [
        "Full",
        "Medium",
        "Medium-Full",
        "Mild",
        "Mild-Medium"
      ],
      "description": "Nicotine strength"
    },
    "classification_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Confidence from automated taxonomy classification."
    },
    "classification_source": {
      "type": "string",
      "description": "Source/audit note for automated taxonomy classification."
    },
    "room_note": {
      "type": "string",
      "enum": [
        "Neutral",
        "Pleasant",
        "Strong",
        "Very Strong"
      ],
      "description": "How it smells to others"
    },
    "flavor_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Flavor characteristics"
    },
    "flavor_profile": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Flavor profile chosen in the tobacco form. Saved alongside flavor_notes."
    },
    "tin_size_oz": {
      "type": "number",
      "description": "Size of individual tin in ounces"
    },
    "tin_total_tins": {
      "type": "number",
      "description": "Total number of tins owned"
    },
    "tin_total_quantity_oz": {
      "type": "number",
      "description": "Total quantity in ounces (calculated: tin_size_oz * tin_total_tins)"
    },
    "tin_tins_open": {
      "type": "number",
      "description": "Number of tins that are opened"
    },
    "tin_tins_cellared": {
      "type": "number",
      "description": "Number of tins cellared/sealed"
    },
    "tin_cellared_date": {
      "type": "string",
      "format": "date",
      "description": "Date when tins were cellared"
    },
    "bulk_total_quantity_oz": {
      "type": "number",
      "description": "Total bulk quantity in ounces"
    },
    "bulk_open": {
      "type": "number",
      "description": "Amount of bulk tobacco that is open (oz)"
    },
    "bulk_cellared": {
      "type": "number",
      "description": "Amount of bulk tobacco that is cellared (oz)"
    },
    "bulk_cellared_date": {
      "type": "string",
      "format": "date",
      "description": "Date when bulk was cellared"
    },
    "pouch_size_oz": {
      "type": "number",
      "description": "Size of individual pouch in ounces"
    },
    "pouch_total_pouches": {
      "type": "number",
      "description": "Total number of pouches owned"
    },
    "pouch_total_quantity_oz": {
      "type": "number",
      "description": "Total quantity in ounces (calculated: pouch_size_oz * pouch_total_pouches)"
    },
    "pouch_pouches_open": {
      "type": "number",
      "description": "Number of pouches that are opened"
    },
    "pouch_pouches_cellared": {
      "type": "number",
      "description": "Number of pouches cellared/sealed"
    },
    "pouch_cellared_date": {
      "type": "string",
      "format": "date",
      "description": "Date when pouches were cellared"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "Current Production",
        "Discontinued",
        "Limited Edition",
        "Vintage"
      ],
      "description": "Whether still being made"
    },
    "aging_potential": {
      "type": "string",
      "enum": [
        "Excellent",
        "Fair",
        "Good",
        "Poor"
      ],
      "description": "How well it ages"
    },
    "rating": {
      "type": "number",
      "description": "Personal rating 1-5"
    },
    "notes": {
      "type": "string",
      "description": "Personal notes about the blend"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "description": "URLs of blend label photos (max 2)"
    },
    "photo": {
      "type": "string",
      "description": "Primary blend photo URL, used as a fallback when no label photo or logo is set"
    },
    "logo": {
      "type": "string",
      "description": "URL of manufacturer/blend logo or label image"
    },
    "image_source_type": {
      "type": "string",
      "description": "How the record's image was obtained (user upload, suggestion, logo library)"
    },
    "image_verified_by_user": {
      "type": "boolean",
      "description": "Whether the collector confirmed the image attached to this record"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a favorite blend"
    },
    "ai_excluded": {
      "type": "boolean",
      "default": false,
      "description": "Exclude from AI matching, pairing, and recommendations (collectible only)"
    },
    "manual_market_value": {
      "type": "number",
      "description": "User-entered current market value (Premium)"
    },
    "cost_basis": {
      "type": "number",
      "description": "Original purchase cost (Premium)"
    },
    "ai_estimated_value": {
      "type": "number",
      "description": "AI-generated estimated market value (Pro)"
    },
    "ai_value_range_low": {
      "type": "number",
      "description": "AI-estimated low end of value range (Pro)"
    },
    "ai_value_range_high": {
      "type": "number",
      "description": "AI-estimated high end of value range (Pro)"
    },
    "ai_confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "description": "Confidence level of AI estimate (Pro)"
    },
    "ai_evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sources used for AI valuation (Pro)"
    },
    "ai_projection_12m": {
      "type": "number",
      "description": "AI-projected value in 12 months (Pro)"
    },
    "ai_projection_36m": {
      "type": "number",
      "description": "AI-projected value in 36 months (Pro)"
    },
    "ai_last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "When AI valuation was last run (Pro)"
    },
    "storage_location_id": {
      "type": "string",
      "description": "Storage location (cellar, cabinet, bin) this blend is kept in"
    },
    "storage_note": {
      "type": "string",
      "description": "Where inside the location the blend sits, e.g. shelf or jar position"
    },
    "packaging_type": {
      "type": "string",
      "enum": [
        "sealed_tin",
        "opened_tin",
        "jar",
        "mason_jar",
        "pouch",
        "bulk_bag",
        "box",
        "vacuum_sealed",
        "other"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue",
        "blue",
        "purple",
        "gray",
        "gray",
        "blue",
        "gray"
      ],
      "description": "How the tobacco is packaged right now"
    },
    "packaging_condition": {
      "type": "string",
      "enum": [
        "sealed",
        "opened",
        "transferred",
        "weathered",
        "unknown"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue",
        "red",
        "gray"
      ],
      "description": "Documented condition of the packaging"
    },
    "cellar_start_date": {
      "type": "string",
      "format": "date",
      "description": "Date this blend entered the cellar, used for cellaring duration"
    },
    "production_date": {
      "type": "string",
      "format": "date",
      "description": "Recorded production or tinning date, when known"
    },
    "batch_number": {
      "type": "string",
      "description": "Batch, lot or production run identifier where applicable"
    },
    "purchase_source": {
      "type": "string",
      "description": "User-entered historical acquisition source. A record of where the blend came from, never a live link."
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date the blend was acquired (historical record)"
    },
    "original_owner": {
      "type": "string",
      "description": "Documented original owner, if the blend was not acquired new"
    },
    "provenance_notes": {
      "type": "string",
      "description": "Free-text provenance documentation: prior owners, cellar history, authentication notes"
    },
    "condition": {
      "type": "string",
      "description": "Documented condition of the tobacco (moisture, aroma, integrity)"
    },
    "condition_notes": {
      "type": "string",
      "description": "Free-text condition documentation"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags and classifications for filtering"
    },
    "documents": {
      "type": "array",
      "description": "Supporting documents (labels, receipts, photographs). Files are stored privately; each entry keeps the private file reference, not a public URL.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receipt",
              "certificate",
              "photograph",
              "document",
              "appraisal",
              "other"
            ]
          },
          "file_uri": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "size": {
            "type": "number"
          }
        }
      }
    },
    "is_custom_blend": {
      "type": "boolean",
      "default": false,
      "description": "Whether this record documents a user-created or shop-blended mixture rather than a manufactured product"
    },
    "blend_recipe": {
      "type": "array",
      "description": "Current component recipe for a custom or mixed blend, as proportions the collector recorded",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "proportion": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "recipe_history": {
      "type": "array",
      "description": "Append-only history of recipe revisions, oldest first",
      "items": {
        "type": "object",
        "properties": {
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "recipe": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "transferred",
        "gifted",
        "sold",
        "lost",
        "disposed"
      ],
      "enumColors": [
        "green",
        "gray",
        "blue",
        "purple",
        "yellow",
        "red",
        "red"
      ],
      "default": "active",
      "description": "Lifecycle state of the record. Non-active states retain the record and its history."
    },
    "lifecycle_note": {
      "type": "string",
      "description": "Why the record is inactive, and to whom it went when transferred or gifted"
    },
    "created_by": {
      "type": "string",
      "description": "Email of the user who created this record"
    }
  },
  "required": [
    "name"
  ]
}