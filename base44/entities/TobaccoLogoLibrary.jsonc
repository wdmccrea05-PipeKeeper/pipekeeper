{
  "name": "TobaccoLogoLibrary",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "description": "Name of the tobacco brand / manufacturer"
    },
    "blend_name": {
      "type": "string",
      "description": "Optional specific blend/product name this image represents. When set, the image is blend-specific (e.g. 'Haunted Bookshop') rather than a generic manufacturer logo. When null, the image is a generic brand logo."
    },
    "logo_url": {
      "type": "string",
      "description": "URL of the brand/blend logo or product image"
    },
    "is_custom": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is a user-uploaded custom logo"
    }
  },
  "required": [
    "brand_name",
    "logo_url"
  ]
}