{
  "name": "SavedReportConfig",
  "type": "object",
  "description": "A saved Reporting Center view: the chosen report plus the filters it was run with. Owner-scoped, so one collector can never read or change another's saved views.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Label the collector gave this saved view"
    },
    "report_id": {
      "type": "string",
      "description": "Id of the report definition this view opens"
    },
    "filters": {
      "type": "object",
      "description": "The filter set stored with the view: modules, date range, storage locations, makers, categories, minimum rating, year and Curator question"
    },
    "created_by": {
      "type": "string",
      "description": "Email of the collector who saved the view"
    }
  },
  "required": [
    "name",
    "report_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}