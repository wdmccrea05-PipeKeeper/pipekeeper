{
  "name": "Cigar",
  "type": "object",
  "description": "A cigar in a user's CigarKeeper collection. Acquisition, provenance, identity, document and lifecycle fields are shared with every other collection module and are all optional.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the cigar (e.g. blend or product name)"
    },
    "brand": {
      "type": "string",
      "description": "Brand or manufacturer of the cigar"
    },
    "line": {
      "type": "string",
      "description": "Series or line within the brand (e.g. Oliva Serie V)"
    },
    "vitola": {
      "type": "string",
      "description": "Size/shape format of the cigar (e.g. Robusto, Toro, Churchill)"
    },
    "wrapper": {
      "type": "string",
      "description": "Wrapper leaf origin or descriptor (e.g. Connecticut Shade, Maduro)"
    },
    "binder": {
      "type": "string",
      "description": "Binder leaf origin or descriptor"
    },
    "filler": {
      "type": "string",
      "description": "Filler blend description or country/region"
    },
    "country_of_origin": {
      "type": "string",
      "description": "Country where the cigar was manufactured"
    },
    "factory": {
      "type": "string",
      "description": "Factory or tabacalera where the cigar was made"
    },
    "body": {
      "type": "string",
      "enum": [
        "mild",
        "mild_medium",
        "medium",
        "medium_full",
        "full"
      ],
      "description": "Overall body profile of the cigar"
    },
    "strength": {
      "type": "string",
      "enum": [
        "mild",
        "mild_medium",
        "medium",
        "medium_full",
        "full"
      ],
      "description": "Nicotine/strength profile of the cigar"
    },
    "flavor_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tasting / flavor note tags"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "regular_production",
        "limited",
        "discontinued",
        "seasonal",
        "unknown"
      ],
      "description": "Production availability status"
    },
    "release_type": {
      "type": "string",
      "enum": [
        "regular",
        "limited_edition",
        "annual_release",
        "special_release",
        "collaboration"
      ],
      "description": "Type of release"
    },
    "length_inches": {
      "type": "number",
      "description": "Length of the cigar in inches"
    },
    "ring_gauge": {
      "type": "number",
      "description": "Ring gauge (diameter in 64ths of an inch)"
    },
    "box_date": {
      "type": "string",
      "format": "date",
      "description": "Box date code (YYYY-MM-DD) if known"
    },
    "barcode": {
      "type": "string",
      "description": "Generic barcode value"
    },
    "upc": {
      "type": "string",
      "description": "Universal Product Code"
    },
    "ean": {
      "type": "string",
      "description": "European Article Number"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternative names or regional names for this cigar"
    },
    "purchase_source": {
      "type": "string",
      "description": "User-entered historical acquisition source. A record of where the cigar came from, never a live link."
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date the cigar was purchased"
    },
    "purchase_price": {
      "type": "number",
      "description": "Price paid at purchase"
    },
    "estimated_value": {
      "type": "number",
      "description": "Current estimated market value"
    },
    "quantity": {
      "type": "number",
      "description": "Number of package units owned (e.g. 2 boxes, 3 singles)"
    },
    "initial_quantity": {
      "type": "number",
      "description": "Starting quantity when first added to collection (for depletion tracking)"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "single",
        "5pack",
        "pack",
        "box",
        "bundle",
        "partial_pack",
        "partial_box"
      ],
      "description": "How the quantity is packaged or counted"
    },
    "cigars_per_package": {
      "type": "number",
      "description": "Number of cigars in each package unit (e.g. 20 for a box of 20, 1 for singles)"
    },
    "singles_equivalent": {
      "type": "number",
      "description": "Total individual stick count (quantity * cigars_per_package, or remaining sticks for a partial package)"
    },
    "humidor_id": {
      "type": "string",
      "description": "Foreign key to a HumidorLocation record"
    },
    "humidor_tray": {
      "type": "string",
      "description": "Optional tray identifier inside the assigned humidor"
    },
    "humidor_shelf": {
      "type": "string",
      "description": "Optional shelf identifier inside the assigned humidor"
    },
    "humidor_drawer": {
      "type": "string",
      "description": "Optional drawer identifier inside the assigned humidor"
    },
    "humidor_section": {
      "type": "string",
      "description": "Optional row/bin/section identifier inside the assigned humidor"
    },
    "storage_notes": {
      "type": "string",
      "description": "Notes about storage, position, or special handling"
    },
    "package_open": {
      "type": "boolean",
      "default": false,
      "description": "Whether the current pack/box is opened or partial"
    },
    "aging_start_date": {
      "type": "string",
      "format": "date",
      "description": "Date aging / resting began"
    },
    "ready_to_smoke_date": {
      "type": "string",
      "format": "date",
      "description": "Estimated date this cigar will be ready to smoke"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this cigar is marked as a favorite"
    },
    "wishlist": {
      "type": "boolean",
      "default": false,
      "description": "Whether this cigar is on the user's wishlist"
    },
    "shopping_list": {
      "type": "boolean",
      "default": false,
      "description": "Whether this cigar is on the user's shopping list"
    },
    "restock_flag": {
      "type": "boolean",
      "default": false,
      "description": "Whether this cigar should be flagged for restock"
    },
    "not_for_me": {
      "type": "boolean",
      "default": false,
      "description": "Whether this cigar should be excluded from future recommendations"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "User rating from 0 to 5"
    },
    "personal_notes": {
      "type": "string",
      "description": "Free-text personal notes about this cigar"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of photo URLs"
    },
    "ai_excluded": {
      "type": "boolean",
      "default": false,
      "description": "Whether this cigar is excluded from AI recommendations"
    },
    "public_visibility": {
      "type": "boolean",
      "default": true,
      "description": "Whether this cigar is visible to other users on public profiles"
    },
    "storage_location_id": {
      "type": "string",
      "description": "Foreign key to a StorageLocation record"
    },
    "original_owner": {
      "type": "string",
      "description": "Documented original owner, if the cigar was not acquired new"
    },
    "provenance_notes": {
      "type": "string",
      "description": "Free-text provenance documentation: prior owners, humidor history, authentication notes"
    },
    "serial_number": {
      "type": "string",
      "description": "Serial or box serial number where applicable"
    },
    "batch_number": {
      "type": "string",
      "description": "Batch, box code or factory lot identifier where applicable"
    },
    "production_date": {
      "type": "string",
      "format": "date",
      "description": "Recorded production or rolling date, when known"
    },
    "condition": {
      "type": "string",
      "description": "Documented condition of the cigar (wrapper, draw, construction)"
    },
    "condition_notes": {
      "type": "string",
      "description": "Free-text condition documentation"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags and classifications for filtering"
    },
    "documents": {
      "type": "array",
      "description": "Supporting documents (receipts, certificates, photographs). Files are stored privately; each entry keeps the private file reference, not a public URL.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receipt",
              "certificate",
              "photograph",
              "document",
              "appraisal",
              "other"
            ]
          },
          "file_uri": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "size": {
            "type": "number"
          }
        }
      }
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "transferred",
        "gifted",
        "sold",
        "lost",
        "disposed"
      ],
      "enumColors": [
        "green",
        "gray",
        "blue",
        "purple",
        "yellow",
        "red",
        "red"
      ],
      "default": "active",
      "description": "Lifecycle state of the record. Non-active states retain the record and its history."
    },
    "lifecycle_note": {
      "type": "string",
      "description": "Why the record is inactive, and to whom it went when transferred or gifted"
    },
    "merged_into_id": {
      "type": "string",
      "description": "When this record was merged into another, the surviving record's id"
    },
    "merged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was merged"
    },
    "created_by": {
      "type": "string",
      "description": "Email of the user who created this record"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when this record was created"
    },
    "updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when this record was last updated"
    }
  },
  "required": [
    "name",
    "created_by"
  ]
}