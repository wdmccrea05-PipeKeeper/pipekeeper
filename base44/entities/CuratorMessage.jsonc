{
  "name": "CuratorMessage",
  "type": "object",
  "description": "One persisted Curator exchange. Records are readable only by the collector they belong to (or an administrator), so a conversation can be restored on another device without ever exposing another collector's thread.",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Parent session ID"
    },
    "user_email": {
      "type": "string",
      "description": "Session owner"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "Message sender role"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "message_index": {
      "type": "number",
      "description": "Order in conversation"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Message timestamp"
    },
    "token_count": {
      "type": "number",
      "description": "Approximate token count"
    }
  },
  "required": [
    "session_id",
    "user_email",
    "role",
    "content",
    "timestamp"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}