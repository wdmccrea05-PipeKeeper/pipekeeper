import { describe, test, expect } from 'vitest';
import { preparePipeData } from '../schemaCompatibility';

describe('preparePipeData — Stamp Photo Persistence', () => {
  test('should preserve stamping_photos array on create', () => {
    const input = {
      name: 'Test Pipe',
      maker: 'Test Maker',
      photos: ['https://example.com/pipe1.jpg'],
      stamping_photos: ['https://example.com/stamp1.jpg', 'https://example.com/stamp2.jpg'],
    };
    
    const result = preparePipeData(input);
    
    expect(result.stamping_photos).toEqual([
      'https://example.com/stamp1.jpg',
      'https://example.com/stamp2.jpg',
    ]);
    expect(result.stamping_photos).toBeDefined();
  });

  test('should preserve stamping_photos array on update', () => {
    const input = {
      id: '123',
      name: 'Updated Pipe',
      photos: ['https://example.com/pipe1.jpg', 'https://example.com/pipe2.jpg'],
      stamping_photos: ['https://example.com/stamp1.jpg'],
    };
    
    const result = preparePipeData(input);
    
    expect(result.stamping_photos).toEqual(['https://example.com/stamp1.jpg']);
  });

  test('should convert undefined stamping_photos to empty array', () => {
    const input = {
      name: 'Test Pipe',
      maker: 'Test Maker',
      photos: ['https://example.com/pipe1.jpg'],
      // stamping_photos not provided
    };
    
    const result = preparePipeData(input);
    
    expect(result.stamping_photos).toEqual([]);
  });

  test('should preserve empty stamping_photos array', () => {
    const input = {
      name: 'Test Pipe',
      photos: ['https://example.com/pipe1.jpg'],
      stamping_photos: [],
    };
    
    const result = preparePipeData(input);
    
    expect(result.stamping_photos).toEqual([]);
  });

  test('should not lose stamping_photos when editing other fields', () => {
    const input = {
      name: 'Test Pipe',
      maker: 'Updated Maker',
      photos: ['https://example.com/pipe1.jpg'],
      stamping_photos: ['https://example.com/stamp1.jpg'],
      shape: 'Billiard',
      bowl_material: 'Briar',
    };
    
    const result = preparePipeData(input);
    
    // stamping_photos should be preserved
    expect(result.stamping_photos).toEqual(['https://example.com/stamp1.jpg']);
    // Other fields should be updated
    expect(result.maker).toBe('Updated Maker');
    expect(result.shape).toBe('Billiard');
  });

  test('should preserve photos array', () => {
    const input = {
      name: 'Test Pipe',
      photos: ['https://example.com/pipe1.jpg', 'https://example.com/pipe2.jpg'],
      stamping_photos: ['https://example.com/stamp1.jpg'],
    };
    
    const result = preparePipeData(input);
    
    expect(result.photos).toEqual([
      'https://example.com/pipe1.jpg',
      'https://example.com/pipe2.jpg',
    ]);
  });

  test('should not include undefined values in result', () => {
    const input = {
      name: 'Test Pipe',
      photos: ['https://example.com/pipe1.jpg'],
      stamping_photos: ['https://example.com/stamp1.jpg'],
      undefined_field: undefined,
      null_field: null,
      empty_string: '',
    };
    
    const result = preparePipeData(input);
    
    expect(result.undefined_field).toBeUndefined();
    expect(result.null_field).toBeUndefined();
    expect(result.empty_string).toBe('');
  });

  test('should handle mixed data types correctly', () => {
    const input = {
      name: 'Test Pipe',
      maker: 'Maker',
      photos: ['https://example.com/1.jpg'],
      stamping_photos: ['https://example.com/stamp1.jpg', 'https://example.com/stamp2.jpg'],
      is_favorite: true,
      estimated_value: 150.50,
      purchase_price: 80,
    };
    
    const result = preparePipeData(input);
    
    expect(result.is_favorite).toBe(true);
    expect(result.estimated_value).toBe(150.50);
    expect(result.purchase_price).toBe(80);
    expect(result.stamping_photos.length).toBe(2);
  });
});