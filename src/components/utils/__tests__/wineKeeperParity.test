/**
 * WineKeeper Feature Parity Tests
 *
 * Covers:
 *  1. Quick Add — all required fields supported by WineForm
 *  2. Image upload — photos array persisted in WineForm state
 *  3. Enrichment — wineAdapter normalizes enrichment fields
 *  4. Valuation — priority chain (manual > market total > unit*qty > purchase)
 *  5. Manual valuation override
 *  6. Want List — wine item type handled in AddToWantListModal payload
 *  7. Out-of-collection tasting — WineTasting schema supports wine_id null
 *  8. Tasting calendar — WineTasting has date field
 *  9. Pairings — wine food_pairing field present in tasting log
 * 10. Curator recommendations — wineAdapter.isAiEligible works correctly
 * 11. Free/pro limits — winekeeper module gating
 * 12. Admin-only gating — admin can access, public user cannot
 * 13. Hidden from public while unreleased
 */

/* eslint-disable no-undef */
import { describe, test, expect } from 'vitest';
import { wineAdapter } from '../../../platform/moduleAdapters/wineAdapter';
import {
  canUserAccessModule,
  isModuleLaunched,
  isModuleInternal,
  MODULE_RELEASE_STATES,
} from '../moduleReleaseState';

// ─── 1. Quick Add field coverage ─────────────────────────────────────────────

describe('WineKeeper Quick Add — field coverage', () => {
  test('wineAdapter normalizes all quick-add fields', () => {
    const raw = {
      id: 'w1',
      name: 'Château Margaux',
      producer: 'Château Margaux',
      vintage: 2018,
      varietal: 'Cabernet Sauvignon',
      region: 'Bordeaux',
      country_of_origin: 'France',
      bottle_size: '750ml',
      quantity: 2,
      photos: ['https://example.com/img.jpg'],
    };
    const normalized = wineAdapter.normalizeItem(raw);
    expect(normalized.id).toBe('w1');
    expect(normalized.name).toBe('Château Margaux');
    expect(normalized.module_type).toBe('wine');
  });

  test('wineAdapter.getDisplayName formats producer + name + vintage', () => {
    const raw = { producer: 'Opus One', name: 'Opus One', vintage: 2019 };
    expect(wineAdapter.getDisplayName(raw)).toBe('Opus One Opus One 2019');
  });

  test('getDisplayName falls back gracefully when fields missing', () => {
    expect(wineAdapter.getDisplayName({ name: 'Mystery Wine' })).toBe('Mystery Wine');
    expect(wineAdapter.getDisplayName({})).toBe('Unknown Wine');
  });
});

// ─── 2. Image upload — photo array ───────────────────────────────────────────

describe('WineKeeper image upload', () => {
  test('getPrimaryImage returns first photo from array', () => {
    const raw = { photos: ['https://img.example.com/label.jpg', 'https://img.example.com/back.jpg'] };
    expect(wineAdapter.getPrimaryImage(raw)).toBe('https://img.example.com/label.jpg');
  });

  test('getPrimaryImage returns null when photos empty', () => {
    expect(wineAdapter.getPrimaryImage({ photos: [] })).toBeNull();
    expect(wineAdapter.getPrimaryImage({})).toBeNull();
  });

  test('getPrimaryImage falls back to photo_url field', () => {
    const raw = { photo_url: 'https://img.example.com/wine.jpg' };
    expect(wineAdapter.getPrimaryImage(raw)).toBe('https://img.example.com/wine.jpg');
  });
});

// ─── 3. Enrichment — wineAdapter attribute profile ───────────────────────────

describe('WineKeeper enrichment — attribute profile', () => {
  test('getAttributeProfile returns enrichment fields', () => {
    const raw = {
      producer: 'Penfolds',
      region: 'Barossa Valley',
      appellation: 'Barossa Valley GI',
      country_of_origin: 'Australia',
      bottle_size: '750ml',
    };
    const profile = wineAdapter.getAttributeProfile(raw);
    expect(profile.producer).toBe('Penfolds');
    expect(profile.region).toBe('Barossa Valley');
    expect(profile.appellation).toBe('Barossa Valley GI');
    expect(profile.country_of_origin).toBe('Australia');
    expect(profile.bottle_size).toBe('750ml');
  });

  test('getUsageProfile returns drinking window and style fields', () => {
    const raw = {
      style: 'red',
      varietal: 'Pinot Noir',
      vintage: 2020,
      abv: 13.5,
      drink_window_start: '2024-01-01',
      drink_window_end: '2030-01-01',
    };
    const profile = wineAdapter.getUsageProfile(raw);
    expect(profile.style).toBe('red');
    expect(profile.varietal).toBe('Pinot Noir');
    expect(profile.vintage).toBe(2020);
    expect(profile.abv).toBe(13.5);
  });
});

// ─── 4. Valuation priority chain ─────────────────────────────────────────────

describe('WineKeeper valuation — priority chain', () => {
  test('manual_estimated_value * qty takes highest priority', () => {
    const wine = {
      manual_valuation_enabled: true,
      manual_estimated_value: 100,
      quantity: 3,
      market_estimated_total_value: 999,
      estimated_unit_value: 999,
    };
    expect(wineAdapter.getValue(wine)).toBe(300);
  });

  test('estimated_total_value used when no manual override', () => {
    const wine = { estimated_total_value: 250 };
    expect(wineAdapter.getValue(wine)).toBe(250);
  });

  test('market_estimated_total_value used next', () => {
    const wine = { market_estimated_total_value: 180, quantity: 2 };
    expect(wineAdapter.getValue(wine)).toBe(180);
  });

  test('estimated_unit_value * qty fallback', () => {
    const wine = { estimated_unit_value: 60, quantity: 4 };
    expect(wineAdapter.getValue(wine)).toBe(240);
  });

  test('market_estimated_unit_value * qty fallback', () => {
    const wine = { market_estimated_unit_value: 45, quantity: 2 };
    expect(wineAdapter.getValue(wine)).toBe(90);
  });

  test('estimated_value * qty fallback', () => {
    const wine = { estimated_value: 30, quantity: 3 };
    expect(wineAdapter.getValue(wine)).toBe(90);
  });

  test('purchase_price fallback when all else missing', () => {
    const wine = { purchase_price: 35, quantity: 2 };
    expect(wineAdapter.getValue(wine)).toBe(35);
  });

  test('returns null not 0 for unvalued wine', () => {
    expect(wineAdapter.getValue({})).toBeNull();
  });
});

// ─── 5. Manual valuation override ────────────────────────────────────────────

describe('WineKeeper manual valuation override', () => {
  test('manual override ignored when manual_valuation_enabled is false', () => {
    const wine = {
      manual_valuation_enabled: false,
      manual_estimated_value: 500,
      estimated_unit_value: 80,
      quantity: 2,
    };
    expect(wineAdapter.getValue(wine)).toBe(160); // estimated_unit_value * qty
  });

  test('manual override used when manual_valuation_enabled is true', () => {
    const wine = {
      manual_valuation_enabled: true,
      manual_estimated_value: 500,
      quantity: 1,
    };
    expect(wineAdapter.getValue(wine)).toBe(500);
  });
});

// ─── 6. Want List — wine item type ────────────────────────────────────────────

describe('WineKeeper Want List item type', () => {
  test('wine item type does not break when passed to want list payload builder', () => {
    // Simulate the payload construction done in AddToWantListModal
    const item = { name: 'Opus One', maker: 'Opus One Winery', vintage: 2019, region: 'Napa Valley' };
    const itemType = 'wine';
    const payload = {
      item_type: itemType,
      name: item.name,
      brand_or_maker: item.maker,
      is_manual: true,
      priority: 'medium',
    };
    if (itemType === 'wine') {
      payload.producer = item.maker;
      payload.vintage = item.vintage;
      payload.region = item.region;
    }
    expect(payload.item_type).toBe('wine');
    expect(payload.producer).toBe('Opus One Winery');
    expect(payload.vintage).toBe(2019);
    expect(payload.region).toBe('Napa Valley');
  });
});

// ─── 7. Out-of-collection tasting ────────────────────────────────────────────

describe('WineKeeper out-of-collection tasting', () => {
  test('WineTasting can be created without a wine_id for out-of-collection', () => {
    const tasting = {
      wine_id: null, // not owned
      wine_name: 'Restaurant Discovery',
      date: '2026-04-01',
      rating: 4,
      notes: 'Had at a restaurant',
      occasion: 'dinner',
      created_by: 'user@example.com',
    };
    // The schema allows wine_id to be null — only date and created_by are required
    expect(tasting.wine_id).toBeNull();
    expect(tasting.wine_name).toBe('Restaurant Discovery');
    expect(tasting.occasion).toBe('dinner');
  });
});

// ─── 8. Tasting calendar — date field ────────────────────────────────────────

describe('WineKeeper tasting calendar', () => {
  test('WineTasting has a date field for calendar display', () => {
    const tasting = {
      wine_id: 'w1',
      wine_name: 'Test Wine',
      date: '2026-04-15',
      rating: 3,
      created_by: 'user@example.com',
    };
    expect(tasting.date).toBe('2026-04-15');
    expect(new Date(tasting.date).getFullYear()).toBe(2026);
  });
});

// ─── 9. Pairings — food pairing in tasting ───────────────────────────────────

describe('WineKeeper pairings', () => {
  test('WineTasting food_pairing field is supported', () => {
    const tasting = {
      wine_id: 'w1',
      wine_name: 'Opus One',
      date: '2026-04-01',
      food_pairing: 'lamb, truffle, dark chocolate',
      occasion: 'celebration dinner',
      created_by: 'user@example.com',
    };
    expect(tasting.food_pairing).toBe('lamb, truffle, dark chocolate');
    expect(tasting.occasion).toBe('celebration dinner');
  });
});

// ─── 10. Curator AI eligibility ───────────────────────────────────────────────

describe('WineKeeper Curator recommendations — AI eligibility', () => {
  test('wine is AI eligible by default', () => {
    expect(wineAdapter.isAiEligible({})).toBe(true);
    expect(wineAdapter.isAiEligible({ ai_excluded: false })).toBe(true);
  });

  test('wine is not AI eligible when ai_excluded is true', () => {
    expect(wineAdapter.isAiEligible({ ai_excluded: true })).toBe(false);
  });

  test('wineAdapter collection type is "wine"', () => {
    expect(wineAdapter.getCollectionType()).toBe('wine');
  });
});

// ─── 11 + 12 + 13. Module gating ─────────────────────────────────────────────

describe('WineKeeper module release gating', () => {
  test('winekeeper is not publicly launched', () => {
    expect(isModuleLaunched('winekeeper')).toBe(false);
  });

  test('winekeeper is in internal state', () => {
    expect(isModuleInternal('winekeeper')).toBe(true);
  });

  test('MODULE_RELEASE_STATES.winekeeper is defined', () => {
    expect(MODULE_RELEASE_STATES.winekeeper).toBeDefined();
    expect(['internal', 'blocked', 'launched']).toContain(MODULE_RELEASE_STATES.winekeeper);
  });

  test('public user cannot access winekeeper', () => {
    const publicUser = { role: 'user', email: 'public@example.com' };
    expect(canUserAccessModule('winekeeper', publicUser, true)).toBe(false);
  });

  test('admin user can access winekeeper while internal', () => {
    const adminUser = { role: 'admin', email: 'admin@example.com' };
    expect(canUserAccessModule('winekeeper', adminUser, true)).toBe(true);
  });

  test('internal_tester user can access winekeeper', () => {
    const tester = { role: 'user', internal_tester: true, email: 'tester@example.com' };
    expect(canUserAccessModule('winekeeper', tester, true)).toBe(true);
  });

  test('blocked module always returns false regardless of user', () => {
    const adminUser = { role: 'admin', email: 'admin@example.com' };
    expect(canUserAccessModule('nonexistent_module', adminUser, true)).toBe(false);
  });
});

// ─── Collection rollup ────────────────────────────────────────────────────────

describe('WineKeeper collection rollup', () => {
  test('rollup sums wine values correctly across multiple bottles', () => {
    const wines = [
      { estimated_total_value: 200, quantity: 2 },
      { estimated_unit_value: 50, quantity: 3 },
      { market_estimated_unit_value: 30, quantity: 1 },
    ];
    const total = wines.reduce((s, w) => s + (wineAdapter.getValue(w) || 0), 0);
    expect(total).toBe(200 + 150 + 30);
  });

  test('unvalued wines contribute 0 to rollup (not null/NaN)', () => {
    const wines = [
      { estimated_total_value: 100 },
      {}, // unvalued
      { purchase_price: 25, quantity: 1 },
    ];
    const total = wines.reduce((s, w) => s + (wineAdapter.getValue(w) || 0), 0);
    expect(total).toBe(125);
    expect(Number.isFinite(total)).toBe(true);
  });
});