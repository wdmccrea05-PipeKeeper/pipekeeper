/* global describe, test, expect */
/**
 * CigarKeeper Free Tier tests
 *
 * Covers:
 *   - Free tier limit definitions exist for cigarkeeper
 *   - canCreateCigar respects the 10-cigar limit
 *   - canCreateHumidor respects the 1-humidor limit
 *   - Paid users bypass all limits
 */

import { checkFreeTierLimit, getFreeTierLimit } from '../freeTierLimits';
import { getModuleLimits, getModuleLimit, hasReachedLimit } from '../moduleLimits';
import { FREE_CIGAR_LIMIT, FREE_HUMIDOR_LIMIT } from '../limitChecks';

// ─── Free tier limit definitions ─────────────────────────────────────────────

describe('CigarKeeper — freeTierLimits.js', () => {
  test('cigarkeeper has a cigars limit of 10', () => {
    expect(getFreeTierLimit('cigarkeeper', 'cigars')).toBe(10);
  });

  test('cigarkeeper has a humidors limit of 1', () => {
    expect(getFreeTierLimit('cigarkeeper', 'humidors')).toBe(1);
  });

  test('cigarkeeper has a cigarSessions limit', () => {
    expect(getFreeTierLimit('cigarkeeper', 'cigarSessions')).toBe(100);
  });
});

describe('CigarKeeper — moduleLimits.js', () => {
  test('getModuleLimits returns cigars and logsPerMonth for cigarkeeper', () => {
    const limits = getModuleLimits('cigarkeeper');
    expect(limits.cigars).toBe(10);
    expect(limits.logsPerMonth).toBe(100);
  });

  test('getModuleLimit returns correct cigar limit', () => {
    expect(getModuleLimit('cigarkeeper', 'cigars')).toBe(10);
  });

  test('hasReachedLimit is false for free user at 9 cigars', () => {
    const freeUser = { has_paid_access: false };
    expect(hasReachedLimit(freeUser, null, 'cigarkeeper', 'cigars', 9)).toBe(false);
  });

  test('hasReachedLimit is true for free user at 10 cigars', () => {
    const freeUser = { has_paid_access: false };
    expect(hasReachedLimit(freeUser, null, 'cigarkeeper', 'cigars', 10)).toBe(true);
  });

  test('hasReachedLimit is false for paid user at 1000 cigars', () => {
    const paidUser = { has_paid_access: true, cigarkeeper_paid: true };
    const paidSub = { status: 'active' };
    expect(hasReachedLimit(paidUser, paidSub, 'cigarkeeper', 'cigars', 1000)).toBe(false);
  });
});

describe('CigarKeeper — limitChecks.js constants', () => {
  test('FREE_CIGAR_LIMIT is 10', () => {
    expect(FREE_CIGAR_LIMIT).toBe(10);
  });

  test('FREE_HUMIDOR_LIMIT is 1', () => {
    expect(FREE_HUMIDOR_LIMIT).toBe(1);
  });
});

describe('CigarKeeper — checkFreeTierLimit (freeTierLimits.js)', () => {
  const freeUser = {};
  const paidUser = { cigarkeeper_paid: true };

  test('free user at limit returns atLimit=true', () => {
    const result = checkFreeTierLimit('cigarkeeper', 'cigars', 10, freeUser);
    expect(result.atLimit).toBe(true);
    expect(result.limit).toBe(10);
  });

  test('free user below limit returns atLimit=false', () => {
    const result = checkFreeTierLimit('cigarkeeper', 'cigars', 5, freeUser);
    expect(result.atLimit).toBe(false);
  });

  test('paid user is never at limit', () => {
    const result = checkFreeTierLimit('cigarkeeper', 'cigars', 1000, paidUser);
    expect(result.atLimit).toBe(false);
    expect(result.limit).toBeNull();
  });

  test('free humidor limit enforced', () => {
    const result = checkFreeTierLimit('cigarkeeper', 'humidors', 1, freeUser);
    expect(result.atLimit).toBe(true);
    expect(result.limit).toBe(1);
  });

  test('paid user has no humidor limit', () => {
    const result = checkFreeTierLimit('cigarkeeper', 'humidors', 5, paidUser);
    expect(result.atLimit).toBe(false);
  });
});