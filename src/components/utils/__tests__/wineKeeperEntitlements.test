/**
 * WineKeeper Profile Preferences — access gating tests
 */
import { describe, test, expect } from 'vitest';
import {
  canUserAccessModule,
  isInternalModuleTester,
  WINEKEEPER_PUBLIC_ENABLED,
} from '@/components/utils/moduleReleaseState';

const adminUser = { role: 'admin', email: 'admin@test.com' };
const regularUser = { role: 'user', email: 'user@test.com' };
const winePaidUser = { role: 'user', email: 'wine@test.com', winekeeper_paid: true };

describe('WineKeeper access gating', () => {
  test('admin user can access winekeeper', () => {
    expect(isInternalModuleTester(adminUser)).toBe(true);
    expect(canUserAccessModule('winekeeper', adminUser, true)).toBe(true);
  });

  test('regular user without entitlement cannot access winekeeper when not public', () => {
    if (WINEKEEPER_PUBLIC_ENABLED) return; // skip if publicly released
    expect(canUserAccessModule('winekeeper', regularUser, false)).toBe(false);
  });

  test('user with winekeeper_paid entitlement can access winekeeper when launched', () => {
    // If launched publicly, entitlement grants access
    if (WINEKEEPER_PUBLIC_ENABLED) {
      expect(canUserAccessModule('winekeeper', winePaidUser, true)).toBe(true);
    } else {
      // Internal: only admins/internal testers can access
      expect(canUserAccessModule('winekeeper', winePaidUser, true)).toBe(false);
    }
  });
});

describe('WineKeeper preferences data shape', () => {
  test('default wine_preferences object has all required fields', () => {
    const defaults = {
      styles: [],
      varietals: [],
      regions: [],
      drinking_goals: [],
      pairing_interests: [],
      flavor_profile: [],
      cellar_strategy: '',
      budget_everyday_min: '',
      budget_everyday_max: '',
      budget_special_min: '',
      budget_special_max: '',
      max_recommendation_price: '',
    };
    expect(Array.isArray(defaults.styles)).toBe(true);
    expect(Array.isArray(defaults.varietals)).toBe(true);
    expect(Array.isArray(defaults.regions)).toBe(true);
    expect(Array.isArray(defaults.drinking_goals)).toBe(true);
    expect(Array.isArray(defaults.pairing_interests)).toBe(true);
    expect(Array.isArray(defaults.flavor_profile)).toBe(true);
    expect(typeof defaults.cellar_strategy).toBe('string');
  });

  test('wine preferences serializes without errors', () => {
    const prefs = {
      styles: ['Red', 'White'],
      varietals: ['Pinot Noir'],
      regions: ['Burgundy'],
      drinking_goals: ['Age/hold bottles'],
      pairing_interests: ['Cigar pairings'],
      flavor_profile: ['Earthy', 'Mineral'],
      cellar_strategy: 'long_term',
      budget_everyday_min: 20,
      budget_everyday_max: 50,
      budget_special_min: 80,
      budget_special_max: 250,
      max_recommendation_price: 300,
    };
    expect(() => JSON.stringify(prefs)).not.toThrow();
    const parsed = JSON.parse(JSON.stringify(prefs));
    expect(parsed.styles).toEqual(['Red', 'White']);
    expect(parsed.cellar_strategy).toBe('long_term');
    expect(parsed.max_recommendation_price).toBe(300);
  });
});